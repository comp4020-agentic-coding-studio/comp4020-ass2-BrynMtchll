---
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../../course-config";
import { courseParts, partLabel } from "../../lib/parts";
import { sessionLabels, siteConfig } from "../../site-config";

const [sessions, lectures, assessments] = await Promise.all([
  getPublishedCollection("sessions"),
  getPublishedCollection("lectures"),
  getPublishedCollection("assessments"),
]);

const shortDate = new Intl.DateTimeFormat("en-AU", {
  day: "numeric",
  month: "short",
  timeZone: "UTC",
});
const fmt = (value: Date) => shortDate.format(value);

const weeks = Array.from({ length: 12 }, (_, i) => i + 1).map((week) => ({
  week,
  part: courseParts.some((p) => p.from === week) ? partLabel(week) : undefined,
  lecture: lectures.find((l) => l.data.week === week),
  session: sessions.find((s) => s.data.week === week),
  due: assessments.filter((a) => a.data.week === week),
}));

const lateAssessments = assessments.filter((a) => a.data.week > 12);
---

<ContentLayout
  title="Schedule"
  description={`The whole of ${courseMeta.code} on one page: what is lectured, what happens in the ${sessionLabels.singular.toLowerCase()}, and what is due.`}
  {...siteConfig}
>
  <p class="lede">
    Twelve weeks, {courseMeta.session} {courseMeta.year}. Lectures are Mondays
    and {sessionLabels.plural.toLowerCase()} are Thursdays. The four parts are
    not chapters — each one depends on the one before it, and weeks 8 to 10 are
    there to test whether the first seven weeks described intelligence or just
    described us.
  </p>

  <div class="table-scroll">
    <table>
      <caption class="visually-hidden">
        Teaching schedule by week, with lecture, {sessionLabels.singular.toLowerCase()} and assessment due dates
      </caption>
      <thead>
        <tr>
          <th scope="col">Week</th>
          <th scope="col">Lecture (Mon)</th>
          <th scope="col">{sessionLabels.singular} (Thu)</th>
          <th scope="col">Due</th>
        </tr>
      </thead>
      <tbody>
        {
          weeks.map((row) => (
            <>
              {row.part && (
                <tr class="part-row">
                  <th scope="rowgroup" colspan="4">{row.part}</th>
                </tr>
              )}
              <tr>
                <th scope="row">{row.week}</th>
                <td>
                  {row.lecture ? (
                    <>
                      <a href={withBase(`/lectures/${row.lecture.id}/`)}>
                        {row.lecture.data.title}
                      </a>
                      <span class="when">{fmt(row.lecture.data.date)}</span>
                    </>
                  ) : (
                    <span class="when">—</span>
                  )}
                </td>
                <td>
                  {row.session ? (
                    <>
                      <a href={withBase(`/sessions/${row.session.id}/`)}>
                        {row.session.data.title}
                      </a>
                      <span class="when">{fmt(row.session.data.date)}</span>
                    </>
                  ) : (
                    <span class="when">—</span>
                  )}
                </td>
                <td>
                  {row.due.length > 0
                    ? row.due.map((a) => (
                        <>
                          <a href={withBase(`/assessments/${a.id}/`)}>{a.data.title}</a>
                          <span class="when">{a.data.weight}% · {fmt(a.data.due)}</span>
                        </>
                      ))
                    : <span class="when">—</span>}
                </td>
              </tr>
            </>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Two dates that are not in the table</h2>
  <p>
    The <a href={withBase("/assessments/position-and-revision/")}>position
    statement</a> is due at the end of week 3 and carries no marks. It is a
    hurdle for the revision in week 11, and it is the one deadline in this
    course that cannot be extended — a statement written in week 8 has already
    been contaminated by the thing it is supposed to predate.
  </p>
  {
    lateAssessments.length > 0 && (
      <p>
        {lateAssessments.map((a) => (
          <>
            The <a href={withBase(`/assessments/${a.id}/`)}>{a.data.title.toLowerCase()}</a>
            {" "}is due {fmt(a.data.due)}, after teaching ends. Bring two organism
            options to Rosalind before the end of week 9; the choice decides more
            of the mark than the writing does.
          </>
        ))}
      </p>
    )
  }

  <h2>Reading</h2>
  <p>
    There is primary literature every week and it is listed on each
    {" "}{sessionLabels.singular.toLowerCase()} page rather than collected here,
    because which paper matters depends on what the week is doing with it. Most
    weeks one paper is the one the seminar turns on.
  </p>
</ContentLayout>

<style>
  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--at-text-secondary);
    border-inline-start: 3px solid var(--at-border);
    padding-inline-start: 1.1rem;
    margin-block-end: 2rem;
  }

  .table-scroll {
    overflow-x: auto;
    margin-block-end: 2rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    text-align: start;
    vertical-align: top;
    padding: 0.6rem 0.75rem;
    border-block-end: 1px solid var(--at-border);
  }

  thead th {
    white-space: nowrap;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--at-text-secondary);
  }

  tbody th[scope="row"] {
    width: 3rem;
    color: var(--at-text-secondary);
  }

  .part-row th {
    padding-block: 1.25rem 0.4rem;
    border-block-end: none;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--at-text-secondary);
  }

  .when {
    display: block;
    margin-block-start: 0.15rem;
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
