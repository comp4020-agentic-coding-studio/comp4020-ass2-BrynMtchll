---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { partLabel } from "../../lib/parts";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";
import "../../styles/figures.css";
import "../../styles/course.css";

export async function getStaticPaths() {
  const [lectures, sessions] = await Promise.all([
    getPublishedCollection("lectures"),
    getPublishedCollection("sessions"),
  ]);
  return lectures.map((lecture) => ({
    params: { slug: lecture.id },
    props: {
      lecture,
      session: sessions.find((s) => s.data.week === lecture.data.week),
    },
  }));
}

const { lecture, session } = Astro.props;
const { Content } = await render(lecture);
const part = partLabel(lecture.data.week);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
---

<ContentLayout title={title} description={lecture.data.description} {...siteConfig}>
  <p class="week-meta">
    {part && <span class="week-meta__part">{part}</span>}
    <span>{formatCourseDate(lecture.data.date)}</span>
    <span class="week-meta__links">
      {lecture.data.slides && <a href={withBase(lecture.data.slides)}>Open the slides</a>}
      {session && (
        <a href={withBase(`/sessions/${session.id}/`)}>
          Week {lecture.data.week} {sessionLabels.singular.toLowerCase()}
        </a>
      )}
      <a href={withBase("/schedule/")}>Schedule</a>
    </span>
  </p>
  <Content />
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} />
</ContentLayout>
